rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estConnecte() {
      return request.auth != null && request.auth.token.email != null;
    }

    function emailUtilisateur() {
      return request.auth.token.email.lower();
    }

    function docAdmin() {
      return get(/databases/$(database)/documents/admins/$(emailUtilisateur()));
    }

    function estAdmin() {
      return estConnecte() &&
        exists(/databases/$(database)/documents/admins/$(emailUtilisateur()));
    }

    function estSuperAdmin() {
      return estAdmin() && docAdmin().data.superAdmin == true;
    }

    function estAdminDeLaPage(pageId) {
      return estAdmin() &&
        (docAdmin().data.superAdmin == true ||
         pageId in docAdmin().data.pageIds);
    }

    // ---------- admins ----------
    // Bootstrap du tout premier super-admin : à créer manuellement depuis la
    // console Firebase (voir README). Ensuite, seuls les super-admins gèrent
    // cette collection depuis l'application.
    match /admins/{email} {
      allow read: if estConnecte() && emailUtilisateur() == email;
      allow read, write: if estSuperAdmin();
    }

    // ---------- pages (une par personne défunte) ----------
    match /pages/{pageId} {
      allow read: if true;
      allow create, update, delete: if estSuperAdmin();

      // ---------- témoignages ----------
      match /temoignages/{temoignageId} {
        allow read: if resource.data.statut == 'approuve' || estAdminDeLaPage(pageId);

        // Dépôt public : pas besoin d'être connecté. Le statut doit
        // impérativement être "en_attente" à la création, et un code (choisi
        // par l'auteur) est obligatoire — c'est lui qui autorisera plus tard
        // la modification ou la suppression, sans compte ni email vérifié.
        allow create: if request.resource.data.statut == 'en_attente'
          && request.resource.data.nomAffiche is string
          && request.resource.data.nomAffiche.size() > 0
          && request.resource.data.nomAffiche.size() < 200
          && request.resource.data.texte is string
          && request.resource.data.texte.size() > 0
          && request.resource.data.texte.size() < 20000
          && request.resource.data.code is string
          && request.resource.data.code.size() >= 4
          && request.resource.data.code.size() < 100;

        // L'auteur, muni du bon code, peut modifier son témoignage (repasse
        // en modération) ou le masquer ("supprime" — un vrai delete ne peut
        // pas être vérifié par code, seule une écriture le peut). Le code
        // soumis doit correspondre exactement à celui enregistré ; ni l'un
        // ni l'autre n'est jamais renvoyé au client.
        allow update: if (request.resource.data.code == resource.data.code
            && (request.resource.data.statut == 'en_attente' || request.resource.data.statut == 'supprime'))
          // ...ou un admin de la page, qui ne touche jamais au contenu ni au code.
          || (estAdminDeLaPage(pageId)
            && request.resource.data.nomAffiche == resource.data.nomAffiche
            && request.resource.data.texte == resource.data.texte
            && request.resource.data.code == resource.data.code);

        allow delete: if estAdminDeLaPage(pageId);
      }
    }

    // ---------- signalements ----------
    // Collection de premier niveau (pas imbriquée sous pages/temoignages) :
    // ça permet des requêtes normales plutôt que des requêtes "collection
    // group", plus simples à valider de façon fiable par les règles.
    match /signalements/{signalementId} {
      allow create: if request.resource.data.pageId is string
        && request.resource.data.temoignageId is string
        && request.resource.data.traite == false;
      allow read, update, delete: if estAdminDeLaPage(resource.data.pageId);
    }

    // ---------- modèles d'email ----------
    // Lecture publique : l'email d'accusé de dépôt part depuis le navigateur
    // du visiteur lui-même, qui doit donc pouvoir lire le modèle. Écriture
    // réservée aux super-admins (onglet Email).
    match /modelesEmail/{type} {
      allow read: if true;
      allow write: if estSuperAdmin();
    }

    // ---------- journal des emails envoyés ----------
    // Sert uniquement au suivi du quota EmailJS (onglet Tests, admin). Écrit
    // à chaque tentative d'envoi, y compris par des visiteurs non connectés
    // (dépôt de témoignage) — lecture réservée aux admins.
    match /emailsEnvoyes/{id} {
      allow create: if request.resource.data.type is string;
      allow read: if estAdmin();
    }
  }
}
